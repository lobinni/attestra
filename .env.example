# No environment variable is required for the verified StudioNet deployment.
# Every value below is public configuration and is optional.

# --- Deployment -------------------------------------------------------------
NEXT_PUBLIC_CONTRACT_ADDRESS=0xbF2a9b0cC3eF529bFFF1873e7FCEB6CecfbdD1BC
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com

# --- Website section visibility ---------------------------------------------
# Accepted values: true, 1, on, yes  /  false, 0, off, no
# A disabled section is removed from navigation and its route returns not found.

# Prepared sample mandates on the overview page and the template picker.
NEXT_PUBLIC_SHOW_SAMPLES=true

# Live mandate registry, mandate creation and the mandate workspace.
NEXT_PUBLIC_SHOW_MANDATES=true

# Operator passport page.
NEXT_PUBLIC_SHOW_OPERATORS=true

# Protocol explanation page.
NEXT_PUBLIC_SHOW_PROTOCOL=true

# Getting-started guide page.
NEXT_PUBLIC_SHOW_GUIDE=true

# Deployment proof page. Disabled by default.
NEXT_PUBLIC_SHOW_CONTRACT=false

# Live protocol statistics block on the overview page.
NEXT_PUBLIC_SHOW_LIVE_STATS=true

# Outcome explanation cards on the overview page.
NEXT_PUBLIC_SHOW_OUTCOMES=true
